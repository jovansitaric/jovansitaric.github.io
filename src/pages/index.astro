        </footer>
        <script>
            const toggle =
                document.querySelector<HTMLButtonElement>(".menu-toggle");
            const nav = document.querySelector<HTMLElement>(".site-nav");
            const closeNavigation = () => {
                toggle?.setAttribute("aria-expanded", "false");
                nav?.classList.remove("open");
                if (toggle) {
                    const language =
                        document.documentElement.lang === "sr" ? "sr" : "en";
                    toggle.setAttribute(
                        "aria-label",
                        translations[language]["nav.open"],
                    );
                }
            };
            const openNavigation = () => {
                toggle?.setAttribute("aria-expanded", "true");
                nav?.classList.add("open");
                if (toggle) {
                    const language =
                        document.documentElement.lang === "sr" ? "sr" : "en";
                    toggle.setAttribute(
                        "aria-label",
                        translations[language]["nav.close"],
                    );
                }
            };
            toggle?.addEventListener("click", () => {
                const open = toggle.getAttribute("aria-expanded") === "true";
                if (open) closeNavigation();
                else openNavigation();
            });
            nav?.querySelectorAll("a").forEach((link) =>
                link.addEventListener("click", closeNavigation),
            );
            document.addEventListener("keydown", (event) => {
                if (
                    event.key === "Escape" &&
                    toggle?.getAttribute("aria-expanded") === "true"
                ) {
                    closeNavigation();
                    toggle.focus();
                }
            });

            const header = document.querySelector(".site-header");
            const parallaxItems =
                document.querySelectorAll<HTMLElement>("[data-parallax]");
            const reduceMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            );
            let scrollFrame = 0;
            const updateHeader = () =>
                header?.classList.toggle("is-scrolled", window.scrollY > 12);
            const updateParallax = () => {
                if (reduceMotion.matches) return;
                parallaxItems.forEach((item) => {
                    const intensity = Number(item.dataset.parallax || 0);
                    const bounds = item.getBoundingClientRect();
                    const progress =
                        (window.innerHeight / 2 -
                            (bounds.top + bounds.height / 2)) *
                        intensity;
                    item.style.setProperty(
                        "--parallax-y",
                        `${Math.max(-18, Math.min(18, progress))}px`,
                    );
                });
            };
            const updateScrollState = () => {
                updateHeader();
                if (!scrollFrame) {
                    scrollFrame = requestAnimationFrame(() => {
                        updateParallax();
                        scrollFrame = 0;
                    });
                }
            };
            updateScrollState();
            window.addEventListener("scroll", updateScrollState, {
                passive: true,
            });

            type Language = "en" | "sr";
            type Theme = "light" | "dark";
