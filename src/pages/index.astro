                        "Good tools.<br /><em>Better intent.</em>",
                    "contact.eyebrow": "Have a project in mind?",
                    "contact.heading":
                        "Let's make<br /><em>something real.</em>",
                    "footer.credit": "Designed & built with care",
                    "project.leisureScroll.type": "Library/Framework",
                    "project.leisureScroll.description":
                        "A library from Leisure ecosystem. It brings animations when user scrolls with a goal of easy setup, lightweight and smooth performance.",
                    "project.portfolio.type": "Astro presentation website",
