        <style is:inline>
            html[data-language-pending] body {
                visibility: hidden;
            }
        </style>
        <script is:inline>
            const root = document.documentElement;
            const preferredLanguage =
                localStorage.getItem("portfolio-language") === "sr"
                    ? "sr"
                    : "en";
            root.lang = preferredLanguage;
            root.dataset.theme =
                localStorage.getItem("portfolio-theme") === "dark"
                    ? "dark"
                    : "light";
            if (preferredLanguage === "sr") {
                root.dataset.languagePending = "true";
                window.setTimeout(() => {
                    if (root.dataset.languagePending) {
                        root.lang = "en";
                        delete root.dataset.languagePending;
                    }
                }, 2000);
            }
        </script>
    </head>
    <body>
        <header class="site-header page-enter">
            <a
                class="brand"
                href="#top"
                data-i18n-aria-label="name.home"
                aria-label="Jovan Sitaric home"
                ><span>JS</span><small data-i18n="name.full"
                    >Jovan Sitaric</small
                ></a
            >
            <nav
                class="site-nav"
                id="primary-navigation"
                aria-label="Main navigation"
                data-i18n-aria-label="nav.label"
            >
                <a href="#about" data-i18n="nav.about">About</a><a
                    href="#experience"
                    data-i18n="nav.experience">Experience</a
