            const languageToggle = document.querySelector<HTMLButtonElement>(
                "[data-language-toggle]",
            );
            const languageLabels: Record<Language, string> = {
                en: "SR",
                sr: "EN",
            };
            const setLanguage = (language: Language) => {
                document.documentElement.lang = language;
                document.querySelectorAll("[data-i18n]").forEach((element) => {
                    const key = element.getAttribute("data-i18n");
                    if (key) {
                        const value = translations[language][key];
                        if (value) element.innerHTML = value;
                    }
                });
                document
                    .querySelectorAll("[data-i18n-aria-label]")
                    .forEach((element) => {
                        const ariaLabelKey = element.getAttribute(
                            "data-i18n-aria-label",
                        );
                        const ariaLabel = ariaLabelKey
                            ? translations[language][ariaLabelKey]
                            : undefined;
                        if (ariaLabel)
                            element.setAttribute("aria-label", ariaLabel);
                    });
                if (languageToggle)
                    languageToggle.textContent = languageLabels[language];
                if (toggle) {
                    const menuIsOpen =
                        toggle.getAttribute("aria-expanded") === "true";
                    toggle.setAttribute(
                        "aria-label",
                        translations[language][
                            menuIsOpen ? "nav.close" : "nav.open"
                        ],
                    );
                }
                localStorage.setItem("portfolio-language", language);
                delete document.documentElement.dataset.languagePending;
                window.dispatchEvent(
                    new CustomEvent("portfolio-language-change", {
                        detail: language,
                    }),
                );
            };
            languageToggle?.addEventListener("click", () => {
                setLanguage(
                    document.documentElement.lang === "en" ? "sr" : "en",
                );
            });
            const storedLanguage = localStorage.getItem("portfolio-language");
            setLanguage(storedLanguage === "sr" ? "sr" : "en");

            const themeToggle = document.querySelector("[data-theme-toggle]");
            const themeLabels: Record<Language, Record<Theme, string>> = {
                en: {
                    light: "Switch to dark theme",
                    dark: "Switch to light theme",
                },
                sr: {
                    light: "Prebaci na tamnu temu",
                    dark: "Prebaci na svetlu temu",
                },
            };
            const setTheme = (theme: Theme) => {
                document.documentElement.dataset.theme = theme;
                document
                    .querySelector<HTMLMetaElement>('meta[name="theme-color"]')
                    ?.setAttribute(
                        "content",
                        theme === "dark" ? "#172b2d" : "#f3efe7",
                    );
                themeToggle?.setAttribute(
                    "aria-pressed",
                    String(theme === "dark"),
                );
                const currentLanguage =
                    document.documentElement.lang === "sr" ? "sr" : "en";
                themeToggle?.setAttribute(
                    "aria-label",
                    themeLabels[currentLanguage][theme],
                );
                localStorage.setItem("portfolio-theme", theme);
            };
            themeToggle?.addEventListener("click", () => {
                setTheme(
                    document.documentElement.dataset.theme === "dark"
                        ? "light"
                        : "dark",
                );
            });
            const storedTheme = localStorage.getItem("portfolio-theme");
            setTheme(
                storedTheme === "dark" || storedTheme === "light"
                    ? storedTheme
                    : window.matchMedia("(prefers-color-scheme: dark)").matches
                        ? "dark"
                        : "light",
            );

            const projectGrid =
                document.querySelector<HTMLElement>(".project-grid");
            const projectSkillFilter = document.querySelector<HTMLElement>(
                ".project-skill-filter",
            );
            const projectSkillToggle =
                document.querySelector<HTMLButtonElement>(
                    "#project-skill-filter-toggle",
                );
            const projectSkillMenu = document.querySelector<HTMLElement>(
                "#project-skill-filter-menu",
            );
            const projectDateSort =
                document.querySelector<HTMLSelectElement>("#project-date-sort");
            if (
                projectGrid &&
                projectSkillFilter &&
                projectSkillToggle &&
                projectSkillMenu &&
                projectDateSort
            ) {
                const projectCards = Array.from(
                    projectGrid.querySelectorAll<HTMLElement>(
                        "[data-project-card]",
                    ),
                );
                const skillCheckboxes = Array.from(
                    projectSkillMenu.querySelectorAll<HTMLInputElement>(
                        'input[type="checkbox"]',
                    ),
                );
                let selectedSkills: string[] = [];
                const syncFilterMenu = () => {
                    skillCheckboxes.forEach((checkbox) => {
                        checkbox.checked = selectedSkills.includes(
                            checkbox.value,
                        );
                    });
                };
                const updateFilterCount = () => {
                    const count = selectedSkills.length;
                    const countIndicator =
                        projectSkillToggle.querySelector<HTMLElement>(
                            "[data-selected-count]",
                        );
                    if (countIndicator)
                        countIndicator.textContent = String(count);
                    const language =
                        document.documentElement.lang === "sr" ? "sr" : "en";
                    const filterLabel =
                        translations[language]["portfolio.filterLabel"];
                    const selectedText =
                        language === "sr" ? "izabrano" : "selected";
                    projectSkillToggle.setAttribute(
                        "aria-label",
                        `${filterLabel}: ${count} ${selectedText}`,
                    );
                };
                const closeFilterMenu = () => {
                    const nextSelectedSkills = skillCheckboxes
                        .filter((checkbox) => checkbox.checked)
                        .map((checkbox) => checkbox.value);
                    const selectionChanged =
                        nextSelectedSkills.length !== selectedSkills.length ||
                        nextSelectedSkills.some(
                            (skill) => !selectedSkills.includes(skill),
                        );
                    if (selectionChanged) {
                        selectedSkills = nextSelectedSkills;
                        updateFilterCount();
                        updateProjects();
                    }
                    projectSkillMenu.hidden = true;
                    projectSkillToggle.setAttribute("aria-expanded", "false");
                };
                const updateProjects = () => {
                    const direction =
                        projectDateSort.value === "oldest" ? 1 : -1;
                    const sortedCards = [...projectCards].sort(
                        (first, second) => {
                            const yearDifference =
                                Number(first.dataset.projectYear) -
                                Number(second.dataset.projectYear);
                            return (
                                yearDifference * direction ||
                                Number(first.dataset.projectOrder) -
                                    Number(second.dataset.projectOrder)
                            );
                        },
                    );

                    let visibleIndex = 0;
                    sortedCards.forEach((card, index) => {
                        const cardSkills =
                            card.dataset.projectSkills?.split("|") ?? [];
                        card.hidden =
                            selectedSkills.length > 0 &&
                            !selectedSkills.some((skill) =>
                                cardSkills.includes(skill),
                            );
                        const projectIndex =
                            card.querySelector<HTMLElement>(".project-index");
                        if (!card.hidden) visibleIndex += 1;
                        if (projectIndex) {
                            projectIndex.textContent = card.hidden
                                ? String(index + 1)
                                : String(visibleIndex);
                        }
                        card.style.setProperty(
                            "--reveal-delay",
                            `${Math.min(index, 5) * 90}ms`,
                        );
                        projectGrid.append(card);
                    });
                };

                projectSkillToggle.addEventListener("click", () => {
                    const isOpen =
                        projectSkillToggle.getAttribute("aria-expanded") ===
                        "true";
                    if (isOpen) {
                        closeFilterMenu();
                        return;
                    }
                    syncFilterMenu();
                    projectSkillMenu.hidden = false;
                    projectSkillToggle.setAttribute("aria-expanded", "true");
                });
                document.addEventListener("click", (event) => {
                    if (
                        !projectSkillMenu.hidden &&
                        event.target instanceof Node &&
                        !projectSkillFilter.contains(event.target)
                    ) {
                        closeFilterMenu();
                    }
                });
                document.addEventListener("keydown", (event) => {
                    if (event.key === "Escape" && !projectSkillMenu.hidden) {
                        closeFilterMenu();
                        projectSkillToggle.focus();
                    }
                });
                projectDateSort.addEventListener("change", updateProjects);
                updateFilterCount();
                window.addEventListener(
                    "portfolio-language-change",
                    updateFilterCount,
                );
                updateProjects();
            }

            const revealItems = document.querySelectorAll("[data-reveal]");
            const revealObserver = new IntersectionObserver(
                (entries) =>
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("is-visible");
                            revealObserver.unobserve(entry.target);
                        }
                    }),
                { threshold: 0.16 },
            );
            revealItems.forEach((item) => revealObserver.observe(item));

            document
                .querySelectorAll<HTMLElement>("[data-tilt]")
                .forEach((card) => {
                    card.addEventListener(
                        "pointermove",
                        (event: PointerEvent) => {
                            if (reduceMotion.matches) return;
                            const bounds = card.getBoundingClientRect();
                            const x =
                                (event.clientX - bounds.left) / bounds.width -
                                0.5;
                            const y =
                                (event.clientY - bounds.top) / bounds.height -
                                0.5;
                            card.style.setProperty("--tilt-x", `${x * 2}deg`);
                            card.style.setProperty("--tilt-y", `${y * -2}deg`);
                        },
                    );
                    card.addEventListener("pointerleave", () => {
                        card.style.setProperty("--tilt-x", "0deg");
                        card.style.setProperty("--tilt-y", "0deg");
                    });
                });
        </script>
    </body>
