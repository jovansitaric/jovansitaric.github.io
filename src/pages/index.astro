                        >☼</span
                    >
                    <span class="theme-icon theme-icon-moon" aria-hidden="true"
                        >☾</span
                    >
                </button>
            </div>
            <button
                class="menu-toggle"
                type="button"
                aria-label="Open navigation"
                data-i18n-aria-label="nav.open"
                aria-controls="primary-navigation"
                aria-expanded="false"><span></span><span></span></button
            >
