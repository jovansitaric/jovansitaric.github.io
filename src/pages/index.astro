---
import ExperienceTabs from "../components/ExperienceTabs.vue";
import { skillList, skills } from "../data/skills";
import "../styles/global.css";

const socialLinks = [
    { label: "GitHub", href: "https://github.com/jovansitaric" },
    { label: "LinkedIn", href: "https://rs.linkedin.com/in/jovan-sitaric" },
];

const projects = [
    {
        title: "Stopnwrap",
        type: "Custom WordPress website",
        year: "2024",
        description:
            "Automotive and car wrap experience website based on WordPress custom theme and ACF plugin.",
        technologies: [skills.wordpress, skills.php, skills.acf, skills.figma],
        image: "/assets/images/projects/Stopnwrap.png",
        href: "https://stopnwrap.rs/",
    },
    {
        title: "Avocado",
        type: "Custom website",
        year: "2024",
        description:
            "A playful product experience with a bright visual system and a focused browsing flow.",
        technologies: [skills.vue, skills.javascript, skills.css],
        image: "/assets/images/projects/Avocado-Zeplin.png",
        href: "https://jovansitaric.github.io/Slatkoteka/",
    },
    {
        title: "Quiz app",
        type: "Interactive experience",
        year: "2023",
        description:
            "A fast quiz interface designed around readable questions, clear feedback, and simple progression.",
        technologies: [skills.html, skills.javascript, skills.css],
        image: "/assets/images/projects/Quiz.png",
        href: "https://jovansitaric.github.io/simple-quiz/",
    },
    {
        title: "Topli Dom",
        type: "Business website",
        year: "2022",
        description:
            "A warm, practical web presence for a construction company, balancing trust with useful information.",
        technologies: [skills.wordpress, skills.php, skills.seo],
        image: "/assets/images/projects/Gradnja-Topli-Dom.png",
        href: "#",
    },
    {
        title: "Zlatara Letic",
        type: "Business website",
        year: "2020",
        description:
            "Jewelry store website with a clean and elegant design, optimized for search engines and user experience.",
        technologies: [skills.wordpress, skills.php, skills.seo, skills.figma],
        image: "/assets/images/projects/ZlataraLetic.jpg",
        href: "https://zlataraletic.rs/",
    },
    {
        title: "Dotkom",
        type: "Entertainment website",
        year: "2020",
        description:
            "A WordPress blog/website for a local entertainment company, featuring news, events, and multimedia content.",
        technologies: [skills.wordpress, skills.php, skills.seo],
        image: "/assets/images/projects/dotkom.jpg",
        href: "https://dotkomsite.wordpress.com/",
    },
];
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta
            name="description"
            content="Portfolio of Jovan Sitaric, front-end developer and web designer."
        />
        <title>Jovan Sitaric | Front-end developer</title>
    </head>
    <body>
        <header class="site-header page-enter">
            <a class="brand" href="#top" aria-label="Jovan Sitaric home"
                ><span>JS</span><small>Jovan Sitaric</small></a
            >
            <nav class="desktop-nav" aria-label="Main navigation">
                <a href="#about" data-i18n="nav.about">About</a><a
                    href="#experience"
                    data-i18n="nav.experience">Experience</a
                ><a href="#portfolio" data-i18n="nav.portfolio">Portfolio</a><a
                    href="#contact"
                    data-i18n="nav.contact">Contact</a
                >
            </nav>
            <div class="header-socials">
                {
                    socialLinks.map((link) => (
                        <a href={link.href} target="_blank" rel="noreferrer">
                            {link.label}
                        </a>
                    ))
                }
            </div>
            <div class="theme-controls">
                <button
                    class="language-toggle"
                    type="button"
                    aria-label="Switch language"
                    data-language-toggle>SR</button
                >
                <button
                    class="theme-toggle"
                    type="button"
                    aria-label="Switch theme"
                    aria-pressed="false"
                    data-theme-toggle></button>
            </div>
            <button
                class="menu-toggle"
                aria-label="Open navigation"
                aria-expanded="false"><span></span><span></span></button
            >
        </header>

        <main id="top">
            <section class="hero section-grid">
                <div class="hero-copy reveal">
                    <p class="eyebrow" data-i18n="hero.eyebrow">
                        Front-end developer / designer
                    </p>
                    <h1>Jovan<br /><em>Sitaric</em></h1>
                    <p class="hero-intro" data-i18n="hero.intro">
                        I build thoughtful digital experiences where clear code
                        meets expressive visual design.
                    </p>
                    <a class="text-link" href="#about" data-i18n="hero.scroll"
                        >Scroll to explore <span>↓</span></a
                    >
                </div>
                <div class="hero-image reveal-delay">
                    <img
                        src="/assets/images/jovan-sitaric.jpg"
                        alt="Jovan Sitaric"
                    />
                </div>
                <div class="hero-stamp hero-stamp-motion">
                    <span data-i18n="hero.stamp"
                        >Available<br />for select<br /><b>projects</b></span
                    >
                </div>
            </section>

            <section
                class="about section-grid motion-section"
                id="about"
                data-reveal
            >
                <div
                    class="section-label"
                    data-i18n="sections.about"
                    data-reveal="heading"
                >
                    01 / About
                </div>
                <div class="about-image motion-card" data-tilt>
                    <img
                        src="/assets/images/about.jpg"
                        alt="Jovan working at a desk"
                    />
                </div>
                <div class="about-copy" data-reveal="delay">
                    <h2 data-i18n="about.heading">
                        Curious by<br /><em>nature.</em>
                    </h2><p data-i18n="about.intro">
                        Hello World! My name is Jovan Sitaric, a front-end
                        developer, web and graphic designer based in Serbia.
                    </p><p data-i18n="about.detail">
                        I have been in love with web development since I stopped
                        being crazy about cartoons. I am always willing to go
                        the extra mile to make a website neater, faster and
                        prettier.
                    </p>
                </div>
            </section>

            <section
                class="experience motion-section"
                id="experience"
                data-reveal
            >
                <div
                    class="section-label"
                    data-i18n="sections.experience"
                    data-reveal="heading"
                >
                    02 / Experience
                </div>
                <div class="section-heading" data-reveal="heading">
                    <p class="eyebrow" data-i18n="experience.eyebrow">
                        A history of making things
                    </p><h2 data-i18n="experience.heading">
                        Work that<br /><em>moved me.</em>
                    </h2>
                </div>
                <ExperienceTabs client:load />
            </section>

            <section class="portfolio motion-section" id="portfolio">
                <div
                    class="section-label"
                    data-i18n="sections.portfolio"
                    data-reveal="heading"
                >
                    03 / Portfolio
                </div>
                <div class="section-heading" data-reveal="heading">
                    <p class="eyebrow" data-i18n="portfolio.eyebrow">
                        A few things I have built
                    </p><h2 data-i18n="portfolio.heading">
                        Selected<br /><em>projects.</em>
                    </h2>
                </div>
                <div class="project-grid">
                    {
                        projects.map((project, index) => (
                            <a
                                class="project-card"
                                data-reveal
                                style={`--reveal-delay: ${Math.min(index, 5) * 90}ms`}
                                href={project.href}
                                target="_blank"
                                rel="noreferrer"
                            >
                                <div class="project-media">
                                    <img
                                        src={project.image}
                                        alt={`${project.title} project`}
                                    />
                                    <span class="project-index">
                                        {index + 1}
                                    </span>
                                    <span class="project-arrow">↗</span>
                                </div>
                                <div class="project-meta">
                                    <div class="project-title-row">
                                        <h3
                                            data-i18n={`project.${index + 1}.title`}
                                        >
                                            {project.title}
                                        </h3>
                                        <span>{project.year}</span>
                                    </div>
                                    <p
                                        class="project-type"
                                        data-i18n={`project.${index + 1}.type`}
                                    >
                                        {project.type}
                                    </p>
                                    <p
                                        class="project-description"
                                        data-i18n={`project.${index + 1}.description`}
                                    >
                                        {project.description}
                                    </p>
                                    <div class="project-technologies">
                                        {project.technologies.map(
                                            (technology) => (
                                                <span>{technology}</span>
                                            ),
                                        )}
                                    </div>
                                </div>
                            </a>
                        ))
                    }
                </div>
                <p
                    class="portfolio-more"
                    data-reveal="heading"
                    data-i18n="portfolio.more"
                >
                    And many more
                </p>
            </section>

            <section
                class="skills section-grid motion-section"
                id="skills"
                data-reveal
            >
                <div
                    class="section-label"
                    data-i18n="sections.skills"
                    data-reveal="heading"
                >
                    04 / Skills
                </div><div class="skills-copy" data-reveal="heading">
                    <p class="eyebrow" data-i18n="skills.eyebrow">
                        Tools of the trade
                    </p><h2 data-i18n="skills.heading">
                        Good tools.<br /><em>Better intent.</em>
                    </h2><div class="skill-cloud">
                        {
                            skillList.map((skill, index) => (
                                <span>
                                    <i>0{index + 1}</i>
                                    {skills[skill]}
                                </span>
                            ))
                        }
                    </div>
                </div>
            </section>

            <section class="contact motion-section" id="contact" data-reveal>
                <div
                    class="section-label"
                    data-i18n="sections.contact"
                    data-reveal="heading"
                >
                    05 / Contact
                </div><div data-reveal="heading">
                    <p class="eyebrow" data-i18n="contact.eyebrow">
                        Have a project in mind?
                    </p><h2 data-i18n="contact.heading">
                        Let's make<br /><em>something real.</em>
                    </h2><a
                        class="contact-link"
                        href="mailto:jovan.sitaric@gmail.com"
                        >jovan.sitaric@gmail.com <span>↗</span></a
                    >
                </div>
            </section>
        </main>
        <footer>
            <span>© {new Date().getFullYear()} Jovan Sitaric</span><span
                data-i18n="footer.credit">Designed & built with care</span
            >
        </footer>
        <script>
            const toggle = document.querySelector(".menu-toggle");
            const nav = document.querySelector(".desktop-nav");
            toggle?.addEventListener("click", () => {
                const open = toggle.getAttribute("aria-expanded") === "true";
                toggle.setAttribute("aria-expanded", String(!open));
                nav?.classList.toggle("open", !open);
            });
            nav?.querySelectorAll("a").forEach((link) =>
                link.addEventListener("click", () => {
                    toggle?.setAttribute("aria-expanded", "false");
                    nav.classList.remove("open");
                }),
            );

            const header = document.querySelector(".site-header");
            const updateHeader = () =>
                header?.classList.toggle("is-scrolled", window.scrollY > 12);
            updateHeader();
            window.addEventListener("scroll", updateHeader, { passive: true });

            type Language = "en" | "sr";
            type Theme = "light" | "dark";
            const translations: Record<Language, Record<string, string>> = {
                en: {
                    "nav.about": "About",
                    "nav.experience": "Experience",
                    "nav.portfolio": "Portfolio",
                    "nav.contact": "Contact",
                    "hero.eyebrow": "Front-end developer / designer",
                    "hero.intro":
                        "I build thoughtful digital experiences where clear code meets expressive visual design.",
                    "hero.scroll": "Scroll to explore <span>↓</span>",
                    "hero.stamp":
                        "Available<br />for select<br /><b>projects</b>",
                    "sections.about": "01 / About",
                    "sections.experience": "02 / Experience",
                    "sections.portfolio": "03 / Portfolio",
                    "sections.skills": "04 / Skills",
                    "sections.contact": "05 / Contact",
                    "about.heading": "Curious by<br /><em>nature.</em>",
                    "about.intro":
                        "Hello World! My name is Jovan Sitaric, a front-end developer, web and graphic designer based in Serbia.",
                    "about.detail":
                        "I have been in love with web development since I stopped being crazy about cartoons. I am always willing to go the extra mile to make a website neater, faster and prettier.",
                    "experience.eyebrow": "A history of making things",
                    "experience.heading": "Work that<br /><em>moved me.</em>",
                    "portfolio.eyebrow": "A few things I have built",
                    "portfolio.heading": "Selected<br /><em>projects.</em>",
                    "portfolio.more": "And many more",
                    "skills.eyebrow": "Tools of the trade",
                    "skills.heading":
                        "Good tools.<br /><em>Better intent.</em>",
                    "contact.eyebrow": "Have a project in mind?",
                    "contact.heading":
                        "Let's make<br /><em>something real.</em>",
                    "footer.credit": "Designed & built with care",
                    "project.01.title": "Avocado",
                    "project.01.type": "Web application",
                    "project.01.description":
                        "A playful product experience with a bright visual system and a focused browsing flow.",
                    "project.02.title": "Quiz app",
                    "project.02.type": "Interactive experience",
                    "project.02.description":
                        "A fast quiz interface designed around readable questions, clear feedback, and simple progression.",
                    "project.03.title": "Gradnja Topli Dom",
                    "project.03.type": "Business website",
                    "project.03.description":
                        "A warm, practical web presence for a construction company, balancing trust with useful information.",
                    "project.04.title": "Topli Dom",
                    "project.04.type": "Business website",
                    "project.04.description":
                        "A warm, practical web presence for a construction company, balancing trust with useful information.",
                    "project.05.title": "Zlatara Letic",
                    "project.05.type": "Business website",
                    "project.05.description":
                        "Jewelry store website with a clean and elegant design, optimized for search engines and user experience.",
                    "project.06.title": "Dotkom",
                    "project.06.type": "Entertainment website",
                    "project.06.description":
                        "A WordPress blog and website for a local entertainment company, featuring news, events, and multimedia content.",
                },
                sr: {
                    "nav.about": "O meni",
                    "nav.experience": "Iskustvo",
                    "nav.portfolio": "Projekti",
                    "nav.contact": "Kontakt",
                    "hero.eyebrow": "Front-end developer / dizajner",
                    "hero.intro":
                        "Gradim promišljena digitalna iskustva u kojima se čist kod susreće sa izražajnim vizuelnim dizajnom.",
                    "hero.scroll": "Istraži dalje <span>↓</span>",
                    "hero.stamp":
                        "Dostupan<br />za odabrane<br /><b>projekte</b>",
                    "sections.about": "01 / O meni",
                    "sections.experience": "02 / Iskustvo",
                    "sections.portfolio": "03 / Projekti",
                    "sections.skills": "04 / Veštine",
                    "sections.contact": "05 / Kontakt",
                    "about.heading": "Radoznao po<br /><em>prirodi.</em>",
                    "about.intro":
                        "Zdravo! Ja sam Jovan Štarić, front-end developer, web i grafički dizajner iz Srbije.",
                    "about.detail":
                        "Zaljubljen sam u web development još od trenutka kada su mi crtani filmovi dosadili. Uvek sam spreman da odem korak dalje kako bi sajt bio uredniji, brži i lepši.",
                    "experience.eyebrow": "Istorija stvaranja",
                    "experience.heading": "Rad koji me<br /><em>pokreće.</em>",
                    "portfolio.eyebrow": "Neki od mojih radova",
                    "portfolio.heading": "Odabrani<br /><em>projekti.</em>",
                    "portfolio.more": "I još mnogo toga",
                    "skills.eyebrow": "Alati zanata",
                    "skills.heading":
                        "Dobri alati.<br /><em>Bolja namera.</em>",
                    "contact.eyebrow": "Imaš projekat na umu?",
                    "contact.heading":
                        "Hajde da napravimo<br /><em>nešto stvarno.</em>",
                    "footer.credit": "Dizajnirano i izrađeno s pažnjom",
                    "project.01.title": "Avocado",
                    "project.01.type": "Web aplikacija",
                    "project.01.description":
                        "Razigrano produktno iskustvo sa vedrim vizuelnim sistemom i fokusiranim tokom pregledanja.",
                    "project.02.title": "Kviz aplikacija",
                    "project.02.type": "Interaktivno iskustvo",
                    "project.02.description":
                        "Brz kviz interfejs zasnovan na čitljivim pitanjima, jasnim povratnim informacijama i jednostavnom napretku.",
                    "project.03.title": "Gradnja Topli Dom",
                    "project.03.type": "Poslovni sajt",
                    "project.03.description":
                        "Toplo i praktično web prisustvo građevinske kompanije koje spaja poverenje sa korisnim informacijama.",
                    "project.04.title": "Topli Dom",
                    "project.04.type": "Poslovni sajt",
                    "project.04.description":
                        "Toplo i praktično web prisustvo građevinske kompanije koje spaja poverenje sa korisnim informacijama.",
                    "project.05.title": "Zlatara Letic",
                    "project.05.type": "Poslovni sajt",
                    "project.05.description":
                        "Sajt zlatarske radnje sa čistim i elegantnim dizajnom, optimizovan za pretraživače i korisničko iskustvo.",
                    "project.06.title": "Dotkom",
                    "project.06.type": "Zabavni sajt",
                    "project.06.description":
                        "WordPress blog i sajt lokalne entertainment kompanije sa vestima, događajima i multimedijalnim sadržajem.",
                },
            };
            const languageToggle = document.querySelector<HTMLButtonElement>(
                "[data-language-toggle]",
            );
            const languageLabels: Record<Language, string> = {
                en: "SR",
                sr: "EN",
            };
            const setLanguage = (language: Language) => {
                document.documentElement.lang = language;
                document.querySelectorAll("[data-i18n]").forEach((element) => {
                    const key = element.getAttribute("data-i18n");
                    if (!key) return;
                    const value = translations[language][key];
                    if (value) element.innerHTML = value;
                });
                if (languageToggle)
                    languageToggle.textContent = languageLabels[language];
                localStorage.setItem("portfolio-language", language);
                window.dispatchEvent(
                    new CustomEvent("portfolio-language-change", {
                        detail: language,
                    }),
                );
            };
            languageToggle?.addEventListener("click", () => {
                setLanguage(
                    document.documentElement.lang === "en" ? "sr" : "en",
                );
            });
            const storedLanguage = localStorage.getItem("portfolio-language");
            setLanguage(storedLanguage === "sr" ? "sr" : "en");

            const themeToggle = document.querySelector("[data-theme-toggle]");
            const themeLabels: Record<Theme, string> = {
                light: "Switch to dark theme",
                dark: "Switch to light theme",
            };
            const setTheme = (theme: Theme) => {
                document.documentElement.dataset.theme = theme;
                themeToggle?.setAttribute(
                    "aria-pressed",
                    String(theme === "dark"),
                );
                themeToggle?.setAttribute("aria-label", themeLabels[theme]);
                localStorage.setItem("portfolio-theme", theme);
            };
            themeToggle?.addEventListener("click", () => {
                setTheme(
                    document.documentElement.dataset.theme === "dark"
                        ? "light"
                        : "dark",
                );
            });
            const storedTheme = localStorage.getItem("portfolio-theme");
            setTheme(storedTheme === "dark" ? "dark" : "light");

            const revealItems = document.querySelectorAll("[data-reveal]");
            const revealObserver = new IntersectionObserver(
                (entries) =>
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("is-visible");
                            revealObserver.unobserve(entry.target);
                        }
                    }),
                { threshold: 0.16 },
            );
            revealItems.forEach((item) => revealObserver.observe(item));

            document
                .querySelectorAll<HTMLElement>("[data-tilt]")
                .forEach((card) => {
                    card.addEventListener(
                        "pointermove",
                        (event: PointerEvent) => {
                            const bounds = card.getBoundingClientRect();
                            const x =
                                (event.clientX - bounds.left) / bounds.width -
                                0.5;
                            const y =
                                (event.clientY - bounds.top) / bounds.height -
                                0.5;
                            card.style.setProperty("--tilt-x", `${x * 2}deg`);
                            card.style.setProperty("--tilt-y", `${y * -2}deg`);
                        },
                    );
                    card.addEventListener("pointerleave", () => {
                        card.style.setProperty("--tilt-x", "0deg");
                        card.style.setProperty("--tilt-y", "0deg");
                    });
                });
        </script>
    </body>
</html>
