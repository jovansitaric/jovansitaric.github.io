                    socialLinks.map((link) => (
                        <a href={link.href} target="_blank" rel="noreferrer">
                            {link.label}
                        </a>
                    ))
                }
            </div>
            <div class="theme-controls">
                <button
                    class="language-toggle"
                    type="button"
                    aria-label="Switch language"
                    data-language-toggle>SR</button
